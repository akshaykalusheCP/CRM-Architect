# Copy to .env (docker compose) or backend/.env (local dev) and fill in.

ENV=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Encrypts AI provider keys saved in the app. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# true when served over HTTPS (required in real deployments)
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]

# Server-default AI provider, used until a workspace admin picks one in the app (AI settings page).
# anthropic | openai | grok | groq | mock (offline, for dev/tests)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max — higher effort = deeper analysis, more tokens
ANTHROPIC_EFFORT=high
# Re-run on Anthropic's recommended model if a request is declined by a safety classifier
ANTHROPIC_SERVER_FALLBACKS=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# xAI Grok (set LLM_PROVIDER=grok)
XAI_API_KEY=
GROK_MODEL=grok-4.7

# Groq (set LLM_PROVIDER=groq) - keys start with gsk_; different company from xAI Grok
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Privacy: mask e-mail/phone sample values before they are sent to the LLM
LLM_MASK_PII_SAMPLES=true
MAX_UPLOAD_MB=25
SALESFORCE_API_VERSION=62.0

# Host port for the web app
WEB_PORT=3000
